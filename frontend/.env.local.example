# Copy this file to .env.local and fill in your values

# OpenAI API Key (optional - mock responses used if not provided)
OPENAI_API_KEY=sk-your-key-here

# App secret for session management
APP_SECRET=your-super-secret-key-change-in-production

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3333

# Backend API URL (FastAPI on port 8888)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8888
